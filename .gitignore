# Arquivos que o Git NUNCA deve enviar ao GitHub

# Senhas e configurações locais (o .env fica só no computador)
.env

# Preferências do editor (cada pessoa tem as suas)
.vscode/

# Arquivos temporários que o Python gera sozinho
__pycache__/
*.pyc

# Evidências e dados gerados pela PoC (ficam fora do repositório)
evidencias/
*.log

# Atalho pessoal (caminhos do computador do Encarregado)
ABRIR_POC.bat

# Trilha de aprendizagem pessoal (fica só no computador)
TRILHA_APRENDIZAGEM.md
treino/

# Artefatos temporários de geração e validação local
.codex-build/
.codex-output/
.codex-finalizer/

# cópias de segurança do banco (nunca no GitHub)
*.dump

# Cola de comandos pessoal (fica só no computador)
docs/operacao/COLA_COMANDOS.md

# Cartilha interna: somente consulta local, nunca publicar documento ou derivados.
documentos_locais/

# Catálogo editorial do FORM 2 disponibilizado apenas na instalação local autorizada.
/app/catalogos/form2_revisao_rev20.json
/app/catalogos/form2_rev18_v1.json
/app/catalogos/form2_controles_rev18_candidata_v2.json

/app/catalogos/form2_rev21_2_privado.json

/app/catalogos/form1_rev22_privado.json

# Derivados documentais privados: não publicar enunciados nem matrizes integrais.
/docs/planejamento/FORM2_REV17_MATRIZ_CORRESPONDENCIA_CANDIDATA.md
/docs/planejamento/GOV_FORMS_REV18_02/
# Saídas e cópias locais de conferência
/output/
/outputs/
/work/
