# Arquivos que o Git NUNCA deve enviar ao GitHub

# Senhas e configurações locais (o .env fica só no computador)
.env

# Preferências do editor (cada pessoa tem as suas)
.vscode/

# Arquivos temporários que o Python gera sozinho
__pycache__/
*.pyc

# Evidências e dados gerados pela PoC (ficam fora do repositório)
evidencias/
*.log

# Atalho pessoal (caminhos do computador do Encarregado)
ABRIR_POC.bat

# Trilha de aprendizagem pessoal (fica só no computador)
TRILHA_APRENDIZAGEM.md
treino/

# Artefatos temporários de geração e validação local
.codex-build/
.codex-output/
.codex-finalizer/

# cópias de segurança do banco (nunca no GitHub)
*.dump

# Cola de comandos pessoal (fica só no computador)
docs/operacao/COLA_COMANDOS.md
